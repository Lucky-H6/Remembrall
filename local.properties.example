# Copy this file to local.properties and fill in your own values.
# local.properties is gitignored — never commit it.

# Android SDK location on your machine
sdk.dir=/path/to/Android/Sdk

# AMap (Gaode) Android SDK key — apply at https://lbs.amap.com/
# bound to package com.memoryball.app + your signing SHA1.
# Leave blank to build & run; the map screen falls back to manual coordinate input.
AMAP_KEY=
